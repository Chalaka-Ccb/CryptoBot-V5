[Unit]
Description=CryptoBot FFFD live trading
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cryptobot
Group=cryptobot
WorkingDirectory=/opt/cryptobot
EnvironmentFile=/etc/cryptobot/live.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cryptobot/.venv/bin/python -m engine.live_engine
StateDirectory=cryptobot
UMask=0077
KillSignal=SIGTERM
TimeoutStopSec=120
# Uncertain submissions require inspection; do not restart blindly.
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cryptobot

[Install]
WantedBy=multi-user.target
