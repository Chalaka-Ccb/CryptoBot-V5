[Unit]
Description=CryptoBot V5 Bitget Channel Rebound
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptobot
WorkingDirectory=/opt/CryptoBot-V5
ExecStart=/opt/CryptoBot-V5/.venv/bin/python run_live.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
