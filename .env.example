# Bitget V1: SONIC/USDT:USDT, Channel Rebound only.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_DEMO=true
# Intentionally disabled by default, including demo order placement.
LIVE_CONFIRM=
SYMBOL=SONIC/USDT:USDT
RISK_PERCENTAGE=0.05
LEVERAGE=5
MARGIN_MODE=isolated
BREAKOUT_EXPIRY_CANDLES=3
POLL_SECONDS=5
PROTECT_CHECK_SECONDS=30
PROTECT_RETRIES=3
MAX_ENTRY_SLIPPAGE=0.001
MARGIN_BUFFER=0.05
MAX_NOTIONAL=
DAILY_DRAWDOWN_LIMIT=0.05
DATA_DIR=data/sonic
LOG_DIR=logs/sonic
